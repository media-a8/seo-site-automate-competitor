RewriteEngine On

# Article source files are not public URLs; articles are served at /articles/{slug}
RewriteRule ^posts(/|$) index.php [L]

# Serve existing files and directories as-is (assets, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Front controller
RewriteRule ^ index.php [QSA,L]
