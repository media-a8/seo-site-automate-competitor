RewriteEngine On

# Articles are always handled by the front controller
RewriteRule ^articles/?$ index.php [L]
RewriteRule ^articles/.+\.(html|json)$ index.php [L]

# Serve existing files and directories as-is (assets, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Front controller
RewriteRule ^ index.php [QSA,L]
